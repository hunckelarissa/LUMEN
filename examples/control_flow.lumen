# Примеры 6.6–6.8 из docs/lumen_spec.md — условия, циклы, break/continue
x = 42

if x > 100
  print("big")
elsif x > 10
  print("medium")
else
  print("small")
end

for i in range(5)
  print(i)
end

n = 0
while n < 3
  print(n)
  n = n + 1
end

# break — выход из цикла
for i in range(10)
  if i == 5
    break
  end
  print(i)
end
# → 0 1 2 3 4

# continue — пропуск итерации
for i in range(6)
  if i % 2 == 0
    continue
  end
  print(i)
end
# → 1 3 5
