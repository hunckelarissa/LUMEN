# Пример 1: метаморфность, эволюция функций, изменение формы объектов

# Создаём переменную со строкой
x = "42"

# При сложении строка автоматически переходит в число
y = x + 1

print("y =", y)   # y = 43


# Эволюция функции: добавляем правила поведения
def show(v):
    if Number:
        print("number:", v)
    if String:
        print("string:", v)
    if List:
        print("list of", len(v), "items")

show(10)
show("hello")
show([1, 2, 3])


# Объект, который меняет форму
user = {name: "Lara"}

# Добавляем новые поля — объект эволюционирует
user.age = 30
user.tags = ["dev", "creator"]

show(user.name)
show(user.tags)


# Контекстная адаптация
print("Hello")   # в CLI → вывод в консоль
